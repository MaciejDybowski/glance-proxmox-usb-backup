# Copy to local/deploy.env (ignored by Git). No passwords or API tokens required.
PVE_HOST=proxmox.example.test
USB_UUID=REPLACE-WITH-FILESYSTEM-UUID
PVE_STORAGE=usb-backup
USB_FILESYSTEM=exfat
USB_DRIVE_NAME="USB backup"
GLANCE_ORIGIN=https://glance.example.test
PANEL_PORT=8765
PANEL_LANGUAGE=en

# Optional: upload YOUR Glance config after deploying the panel.
# GLANCE_SSH_TARGET=admin@glance.example.test
# GLANCE_CONFIG_FILE=/absolute/path/to/your/private/glance.yml
# GLANCE_CONFIG_PATH=/opt/glance_data/glance.yml
